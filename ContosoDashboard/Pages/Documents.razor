@page "/documents"
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Documents</h1>
        <a href="/" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Upload a document</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Title</label>
                    <InputText @bind-Value="title" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <InputSelect @bind-Value="selectedCategory" class="form-select">
                        @foreach (var category in categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-12">
                    <label class="form-label">Description</label>
                    <InputTextArea @bind-Value="description" class="form-control" rows="3" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Project (optional)</label>
                    <InputSelect @bind-Value="selectedProjectId" class="form-select">
                        <option value="">Personal file</option>
                        @foreach (var project in userProjects)
                        {
                            <option value="@project.ProjectId">@project.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label">File</label>
                    <InputFile OnChange="HandleSelectedFile" class="form-control" />
                </div>
            </div>

            <div class="mt-3 d-flex align-items-center gap-2">
                <button class="btn btn-primary" @onclick="UploadDocumentAsync" disabled="@(isUploading || selectedFile == null)">
                    @(isUploading ? "Uploading..." : "Upload document")
                </button>
                @if (selectedFile != null)
                {
                    <span class="text-muted">@selectedFile.Name</span>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Your documents</h5>
        </div>
        <div class="card-body">
            @if (documents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Project</th>
                                <th>Uploaded</th>
                                <th>Size</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in documents)
                            {
                                <tr>
                                    <td>@document.Title</td>
                                    <td>@document.Category</td>
                                    <td>@(document.Project?.Name ?? "Personal")</td>
                                    <td>@document.UploadDateUtc.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td>@FormatFileSize(document.FileSizeBytes)</td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteDocumentAsync(document.DocumentId)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No documents have been uploaded yet.</p>
            }
        </div>
    </div>
</div>

@code {
    private const int MaxUploadBytes = 25 * 1024 * 1024;

    private int currentUserId;
    private string title = string.Empty;
    private string description = string.Empty;
    private string selectedCategory = "Project Documents";
    private string? selectedProjectId;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private readonly List<string> categories = new()
    {
        "Project Documents",
        "Team Resources",
        "Personal Files",
        "Reports",
        "Presentations",
        "Other"
    };

    private List<Project> userProjects = new();
    private List<Document> documents = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);

        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            userProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
            documents = await DocumentService.GetAccessibleDocumentsAsync(currentUserId);
        }
    }

    private void HandleSelectedFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task UploadDocumentAsync()
    {
        if (selectedFile == null)
        {
            errorMessage = "Please choose a file to upload.";
            return;
        }

        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Please provide a document title.";
            return;
        }

        if (selectedFile.Size > MaxUploadBytes)
        {
            errorMessage = "File size must be 25 MB or less.";
            return;
        }

        isUploading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            int? projectId = string.IsNullOrWhiteSpace(selectedProjectId) ? null : int.Parse(selectedProjectId);
            using var stream = selectedFile.OpenReadStream(MaxUploadBytes);

            await DocumentService.UploadDocumentAsync(
                currentUserId,
                title,
                selectedCategory,
                description,
                projectId,
                stream,
                selectedFile.Size,
                selectedFile.Name,
                selectedFile.ContentType);

            title = string.Empty;
            description = string.Empty;
            selectedProjectId = null;
            selectedCategory = "Project Documents";
            selectedFile = null;

            documents = await DocumentService.GetAccessibleDocumentsAsync(currentUserId);
            successMessage = "Document uploaded successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteDocumentAsync(int documentId)
    {
        var success = await DocumentService.DeleteDocumentAsync(documentId, currentUserId);
        if (success)
        {
            documents = await DocumentService.GetAccessibleDocumentsAsync(currentUserId);
            successMessage = "Document deleted successfully.";
        }
        else
        {
            errorMessage = "You are not authorized to delete that document.";
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024} KB";
        }

        return $"{bytes / (1024 * 1024)} MB";
    }
}
